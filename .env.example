# Sao chép file này thành .env và chỉnh sửa giá trị phù hợp.

# Chế độ đăng nhập: none (phát triển/local) | google (triển khai thật)
AUTH_MODE=none

# Danh sách email được phép dùng app (chỉ áp dụng khi AUTH_MODE=google), phân cách bằng dấu phẩy
ALLOWED_EMAILS=

# Danh sách email có quyền Admin, phân cách bằng dấu phẩy
ADMIN_EMAILS=

# Thư mục lưu trữ local (LocalStorageAdapter)
LOCAL_STORAGE_ROOT=data/local_storage

# --- Milestone 5: Supabase (chưa dùng trong MVP) ---
# SUPABASE_URL=
# SUPABASE_KEY=

# --- Milestone 5: Google OAuth (chưa dùng trong MVP) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
